# --- Database (Tasks 1-4, owned by Duclos) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pharmacy
DB_USER=pharmacy
DB_PASSWORD=
# Managed providers (Neon, Supabase, RDS) need this.
DB_SSL=false
# Logs every SQL statement — noisy, but invaluable while debugging.
DB_LOGGING=false

# --- Auth (Tasks 1-4, owned by Duclos) ---
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# --- API ---
PORT=3000
# Comma separated list, used by main.ts for CORS
CORS_ORIGIN=http://localhost:5173

# --- Alerts ---
# How often AlertScheduler re-checks expiry and reorder levels, in minutes.
ALERT_SCAN_INTERVAL_MINUTES=60

# --- Pharmacy details shown to customers (Task 6) ---
PHARMACY_NAME=Night Owl Pharmacy
PHARMACY_ADDRESS=
PHARMACY_PHONE=0787377750
PHARMACY_EMAIL=
PHARMACY_HOURS=Mon-Fri 08:00-20:00, Sat 09:00-17:00

# --- Migrations only ---
# scripts/migrate.ps1 reads this instead of the DB_* parts above.
DATABASE_URL=postgres://pharmacy:password@localhost:5432/pharmacy
